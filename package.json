{
  "name": "sillytavern-gateway",
  "version": "1.0.0",
  "description": "SillyTavern 多平台聊天网关插件 - 支持 QQ/Telegram/Discord/飞书",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test --test-force-exit \"test/*.test.js\"",
    "test:watch": "node --test --watch \"test/*.test.js\"",
    "token": "node scripts/show-token.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "sillytavern",
    "gateway",
    "chatbot",
    "qq",
    "telegram",
    "discord",
    "onebot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.14.0",
    "dotenv": "^16.4.5",
    "eventemitter3": "^5.0.0",
    "express": "^4.18.0",
    "multer": "^1.4.5-lts.1",
    "node-telegram-bot-api": "^0.66.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "ws": "^8.16.0"
  },
  "optionalDependencies": {
    "@larksuiteoapi/node-sdk": "^1.30.0",
    "dingtalk-stream": "^2.1.5",
    "qq-official-bot": "^1.2.3"
  }
}
