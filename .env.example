# SillyTavern Gateway 环境变量配置
#
#   cp .env.example .env   然后取消注释并填值
#
# 优先级：环境变量 > config/gateway.json > 内置默认值
#
# ⚠️ 标注"敏感"的项由环境变量注入后，**不会**被写进 config/gateway.json。
#    这是有意为之：config/ 是挂载卷，凭据写进去等于落盘。
#    所以你在这里改了值，重启即生效，不会被文件里的旧值干扰。

# 时区（影响日志时间戳与模板中的 {{time}}）
TZ=Asia/Shanghai

# ══════════════════════════════════════════════════════════
# 快速开始：最小可用配置
# ══════════════════════════════════════════════════════════
# 1) 鉴权 token —— 不填则首次启动自动生成，需从日志或 config/gateway.json 取出
#    自己指定更方便（要填进 SillyTavern 网关面板）：
#GATEWAY_AUTH_TOKEN=换成你自己的随机长字符串
#
# 2) 至少启用一个平台，例如 Telegram：
#GATEWAY_TELEGRAM_ENABLED=true
#GATEWAY_TELEGRAM_BOT_TOKEN=从 @BotFather 获取
#
# 3) 若用自建推理管线（不想一直开着 SillyTavern 页面）：
#GATEWAY_RUNTIME_ENABLED=true
#GATEWAY_LLM_PROVIDER=openai
#GATEWAY_LLM_API_KEY=sk-...
#GATEWAY_LLM_MODEL=gpt-4o-mini

# ══════════════════════════════════════════════════════════
# 全部可用配置项（下面由 server/utils/env-config.js 的映射表生成）
# ══════════════════════════════════════════════════════════

# ── 网关服务 ────────────────────────────────────────────────
# server.port (number)
#GATEWAY_PORT=
# server.host (string)
#GATEWAY_HOST=
# server.authToken (string)  # ⚠️ 敏感：不会被写入 config/gateway.json
#GATEWAY_AUTH_TOKEN=
# server.requireAuth (boolean)
#GATEWAY_REQUIRE_AUTH=
# server.allowedOrigins (array)
#GATEWAY_ALLOWED_ORIGINS=
# admins (array)
#GATEWAY_ADMINS=

# ── QQ (OneBot / NapCat) ────────────────
# adapters.qq.enabled (boolean)
#GATEWAY_QQ_ENABLED=
# adapters.qq.mode (string)
#GATEWAY_QQ_MODE=
# adapters.qq.wsUrl (string)
#GATEWAY_QQ_WS_URL=
# adapters.qq.reversePort (number)
#GATEWAY_QQ_REVERSE_PORT=
# adapters.qq.accessToken (string)  # ⚠️ 敏感：不会被写入 config/gateway.json
#GATEWAY_QQ_ACCESS_TOKEN=
# adapters.qq.requireMention (boolean)
#GATEWAY_QQ_REQUIRE_MENTION=

# ── Telegram ────────────────────────────────────────
# adapters.telegram.enabled (boolean)
#GATEWAY_TELEGRAM_ENABLED=
# adapters.telegram.botToken (string)  # ⚠️ 敏感：不会被写入 config/gateway.json
#GATEWAY_TELEGRAM_BOT_TOKEN=
# adapters.telegram.mode (string)
#GATEWAY_TELEGRAM_MODE=
# adapters.telegram.allowedUsers (array)
#GATEWAY_TELEGRAM_ALLOWED_USERS=
# adapters.telegram.requireMention (boolean)
#GATEWAY_TELEGRAM_REQUIRE_MENTION=

# ── Discord ──────────────────────────────────────────
# adapters.discord.enabled (boolean)
#GATEWAY_DISCORD_ENABLED=
# adapters.discord.botToken (string)  # ⚠️ 敏感：不会被写入 config/gateway.json
#GATEWAY_DISCORD_BOT_TOKEN=
# adapters.discord.allowedChannels (array)
#GATEWAY_DISCORD_ALLOWED_CHANNELS=
# adapters.discord.allowedUsers (array)
#GATEWAY_DISCORD_ALLOWED_USERS=
# adapters.discord.requireMention (boolean)
#GATEWAY_DISCORD_REQUIRE_MENTION=

# ── 飞书 / Lark ──────────────────────────────────────
# adapters.feishu.enabled (boolean)
#GATEWAY_FEISHU_ENABLED=
# adapters.feishu.appId (string)
#GATEWAY_FEISHU_APP_ID=
# adapters.feishu.appSecret (string)  # ⚠️ 敏感：不会被写入 config/gateway.json
#GATEWAY_FEISHU_APP_SECRET=
# adapters.feishu.domain (string)
#GATEWAY_FEISHU_DOMAIN=
# adapters.feishu.requireMention (boolean)
#GATEWAY_FEISHU_REQUIRE_MENTION=
# adapters.feishu.mediaBaseUrl (string)
#GATEWAY_FEISHU_MEDIA_BASE_URL=

# ── QQ 官方机器人 ────────────────────────────────────────
# adapters.qqofficial.enabled (boolean)
#GATEWAY_QQOFFICIAL_ENABLED=
# adapters.qqofficial.appId (string)
#GATEWAY_QQOFFICIAL_APP_ID=
# adapters.qqofficial.secret (string)  # ⚠️ 敏感：不会被写入 config/gateway.json
#GATEWAY_QQOFFICIAL_SECRET=
# adapters.qqofficial.token (string)  # ⚠️ 敏感：不会被写入 config/gateway.json
#GATEWAY_QQOFFICIAL_TOKEN=
# adapters.qqofficial.sandbox (boolean)
#GATEWAY_QQOFFICIAL_SANDBOX=

# ── 钉钉 ────────────────────────────────────────────────────
# adapters.dingtalk.enabled (boolean)
#GATEWAY_DINGTALK_ENABLED=
# adapters.dingtalk.clientId (string)
#GATEWAY_DINGTALK_CLIENT_ID=
# adapters.dingtalk.clientSecret (string)  # ⚠️ 敏感：不会被写入 config/gateway.json
#GATEWAY_DINGTALK_CLIENT_SECRET=

# ── 自建推理管线（无需挂 ST 浏览器） ────────────────────
# runtime.enabled (boolean)
#GATEWAY_RUNTIME_ENABLED=
# runtime.tokenBudget (number)
#GATEWAY_RUNTIME_TOKEN_BUDGET=
# runtime.stream (boolean)
#GATEWAY_RUNTIME_STREAM=
# runtime.historyLimit (number)
#GATEWAY_RUNTIME_HISTORY_LIMIT=
# runtime.llm.provider (string)
#GATEWAY_LLM_PROVIDER=
# runtime.llm.baseUrl (string)
#GATEWAY_LLM_BASE_URL=
# runtime.llm.apiKey (string)  # ⚠️ 敏感：不会被写入 config/gateway.json
#GATEWAY_LLM_API_KEY=
# runtime.llm.model (string)
#GATEWAY_LLM_MODEL=

# ── 会话与消息队列 ──────────────────────────────────────────
# session.maxHistoryLength (number)
#GATEWAY_SESSION_MAX_HISTORY=
# messageQueue.maxRetries (number)
#GATEWAY_QUEUE_MAX_RETRIES=
# messageQueue.sendTimeout (number)
#GATEWAY_QUEUE_SEND_TIMEOUT=


# ══════════════════════════════════════════════════════════
# 容器内访问宿主机服务
# ══════════════════════════════════════════════════════════
# compose 已配好 host.docker.internal，可这样指向宿主机上的服务：
#GATEWAY_QQ_WS_URL=ws://host.docker.internal:8080
#GATEWAY_LLM_BASE_URL=http://host.docker.internal:11434/v1
#
# 若用 --profile napcat 一起启动 NapCat，则直接用服务名：
#GATEWAY_QQ_WS_URL=ws://napcat:3001
#NAPCAT_ACCOUNT=你的QQ号
#
# SillyTavern 页面跨域访问网关（ST 不在 localhost 时需要）：
#GATEWAY_ALLOWED_ORIGINS=http://192.168.1.10:8000

# NapCat 容器以哪个 uid/gid 运行。镜像默认取 0，会把宿主机 ./napcat/*
# 变成 root 属主，你之后备份/清理会撞权限。填自己的（id -u / id -g）：
#NAPCAT_UID=1000
#NAPCAT_GID=1000

# ══════════════════════════════════════════════════════════
# 仅 docker-compose 使用（不是网关本身的配置项）
# ══════════════════════════════════════════════════════════
# 宿主机端口绑定地址。默认 127.0.0.1，即只有本机能连。
#
# ⚠️ 要从别的设备访问时，**填具体网卡地址，别填 0.0.0.0**：
#    有公网 IP 的 VPS、或路由器做过端口转发/DMZ 的家用网络，
#    0.0.0.0 就等于把持有你全部 bot token 的网关挂到公网上。
#    另外 Docker 发布端口走的是 nat/FORWARD 链，**ufw 管不住它**——
#    你 `ufw status` 看着只放行了 443，3210 照样对全网敞开。
#    详见 docs/DEPLOYMENT.md 第四节。
#GATEWAY_BIND_ADDR=192.168.1.10

# 容器以哪个 uid/gid 运行。不填则跟随挂载目录现有属主（多数情况不用管）。
# 多用户机器、或你的 uid 不是 1000 时建议显式指定（id -u / id -g）：
#PUID=1000
#PGID=1000

# 资源上限。插件是在网关主进程里执行的，没有配额时一个坏插件
# 撑爆的是宿主机内存而不是容器。小内存机器可以调低。
#GATEWAY_MEM_LIMIT=1g
#GATEWAY_PIDS_LIMIT=512
#NAPCAT_MEM_LIMIT=2g
